# Copy to .env in the repository root and fill in your values.
# .env is ignored by Git. Never commit real credentials.

# Infoblox Service API key (Infoblox CSP portal -> System -> Administration -> User Access -> Service API Keys)
# Ensure that the user for which API key is created is part of the ib-mcp-server-user or ib-mcp-server-admin groups in the Infoblox CSP portal
# Issue it to a Service User with a read-only DDI role.
INFOBLOX_API_KEY=

# Tenable Hexa AI MCP Server
# See: https://docs.tenable.com/exposure-management/Content/getting-started/hexa-AI-MCP.htm
TENABLE_MCP_URL=
TENABLE_MCP_AUTH_HEADER=
